package network

import (
	"bufio"
	"context"
	"fmt"
	"log"

	"github.com/libp2p/go-libp2p/core/host"
	"github.com/libp2p/go-libp2p/core/network"
	"github.com/libp2p/go-libp2p/core/peer"
)

func RegisterChatHandler(h host.Host) {
	h.SetStreamHandler(ChatProtocol, handleChatStream)
}

