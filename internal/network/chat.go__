func handleChatStream(stream network.Stream) {
    reader := bufio.NewReader(stream)
    for {
        msg, err := reader.ReadString('\n')
        if err != nil {
            break  // خروج از حلقه وقتی استریم بسته شد
        }
        fmt.Printf("💬 %s: %s", stream.Conn().RemotePeer(), msg)
    }
}

func SendMessage(ctx context.Context, h host.Host, peerID peer.ID, text string) error {
	stream, err := h.NewStream(ctx, peerID, ChatProtocol)
	if err != nil {
		return err
	}
	defer stream.Close()

	writer := bufio.NewWriter(stream)
	_, err = writer.WriteString(fmt.Sprintf("%s\n", text))
	if err != nil {
		return err
	}

	return writer.Flush()
}
